# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/privacy_analyzer

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- ML service (the ML teammate's FastAPI service, e.g. from ml-service/) ---
# Local dev (running `uvicorn app:app` from ml-service/): http://localhost:8000
# Docker Compose (service name "ml-service" on the same network): http://ml-service:8000
# Leave empty to use app/ml_client.py's local stub instead.
ML_SERVICE_URL=http://localhost:8000

# --- Misc ---
ENVIRONMENT=development
